# Alle Werte sind optional. In Dockhand/Portainer können sie auch als Stack-Variablen gesetzt werden.

# Port, unter dem das Tool auf dem Docker-Host erreichbar ist (https://<host>:HOST_PORT)
HOST_PORT=8443

# Schlüssel für die Verschlüsselung gespeicherter Geheimnisse (z.B. openssl rand -hex 32).
# Leer lassen = wird beim ersten Start automatisch im Volume erzeugt (/data/.secret_key).
# ACHTUNG: Ein einmal verwendeter Schlüssel darf nicht mehr geändert werden!
SECRET_KEY=

# Anzeigename in der Oberfläche
APP_TITLE=VPN-Manager

# Zeitzone für Anzeigen
TZ=Europe/Berlin

# HTTPS direkt im Container (selbstsigniertes Zertifikat wird in /data/tls erzeugt).
# Auf "false" setzen, wenn ein Reverse-Proxy TLS übernimmt.
TLS_ENABLED=true
